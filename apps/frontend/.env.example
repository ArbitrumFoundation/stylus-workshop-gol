# Copy to `.env.local` and fill in with the addresses output by the
# deploy commands. Vite picks up `.env.local` automatically (it is
# gitignored). See apps/frontend/src/config/contracts.ts for the read
# path.

# `pnpm --filter contracts-stylus deploy:local` prints
#   "deployed code at address: 0x..."
VITE_RUST_NFT_ADDRESS=

# `pnpm --filter contracts-solidity deploy:local` prints
#   "Deployed to: 0x..."
VITE_SOLIDITY_NFT_ADDRESS=

# `STYLUS_NFT_ADDRESS=<rust-addr> pnpm --filter contracts-solidity deploy:local-with-stylus`
# prints "Deployed to: 0x..."
VITE_SOLIDITY_AND_STYLUS_NFT_ADDRESS=
