# Copy to `.env.local` and fill in. Vite picks up `.env.local`
# automatically (it is gitignored) and hot-reloads when it changes.

# Optional RPC override.
#
# Leave commented for local dev and for Codespaces — both will route
# through the Vite dev-server proxy at `/rpc`, which forwards to
# http://localhost:8547 without tripping CORS.
#
# Only set this when you want the frontend to talk to a *different*
# RPC entirely (Arbitrum Sepolia, mainnet, a remote node, etc.).
#
# VITE_RPC_URL=https://your-remote-rpc.example.com

# `pnpm --filter contracts-stylus deploy:local` prints
#   "deployed code at address: 0x..."
VITE_RUST_NFT_ADDRESS=

# `pnpm --filter contracts-solidity deploy:local` prints
#   "Deployed to: 0x..."
VITE_SOLIDITY_NFT_ADDRESS=

# `STYLUS_NFT_ADDRESS=<rust-addr> pnpm --filter contracts-solidity deploy:local-with-stylus`
# prints "Deployed to: 0x..."
VITE_SOLIDITY_AND_STYLUS_NFT_ADDRESS=
